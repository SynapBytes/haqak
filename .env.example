# ── GitHub Actions secrets ────────────────────────────────────────────────────
# These variables are used only by CI/CD workflows.
# DO NOT put real values in a local .env file — set them in:
#   GitHub → Settings → Secrets and variables → Actions → New repository secret
# Documented here so contributors know which secrets must be configured for CI.
SUPABASE_ACCESS_TOKEN=your_supabase_personal_access_token
SUPABASE_PROJECT_ID=wfuofurgkswotwuzosdd

# ── Frontend (Vite / Vercel) ──────────────────────────────────────────────────
VITE_SUPABASE_URL=https://wfuofurgkswotwuzosdd.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6IndmdW9mdXJna3N3b3R3dXpvc2RkIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzYzNzA2NzAsImV4cCI6MjA5MTk0NjY3MH0.TqA5IBu9uE1q31xUubBrRU4Dv43CaGu1STqhu6sTk1w
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key
VITE_ENV=development
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.webp

# Analytics — PostHog
VITE_POSTHOG_KEY=phc_your_posthog_project_api_key
VITE_POSTHOG_HOST=https://app.posthog.com
# Salt used to hash user IDs before sending to PostHog (keeps PII off third-party servers)
# Generate with: openssl rand -hex 32
VITE_HASH_SALT=your_random_32_byte_hex_salt

# Error monitoring — Sentry
VITE_SENTRY_DSN=https://your_sentry_dsn@sentry.io/your_project_id

# Server-side (Supabase Edge Functions / Vercel env)
SUPABASE_URL=https://wfuofurgkswotwuzosdd.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6IndmdW9mdXJna3N3b3R3dXpvc2RkIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzYzNzA2NzAsImV4cCI6MjA5MTk0NjY3MH0.TqA5IBu9uE1q31xUubBrRU4Dv43CaGu1STqhu6sTk1w
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# SERVICE_ROLE_KEY is auto-injected by Supabase Edge Functions runtime.
# For zero-downtime rotation via Supabase Vault, see docs/DEPLOYMENT.md.
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
ENVIRONMENT=development

# OTP hardening
# HMAC secret for signing stored OTP tokens (keeps raw OTPs out of the database).
# This is used by Edge Functions to HMAC-sign OTP tokens before storage.
# It is NOT the OTP email/SMS code itself — Supabase Auth handles OTP delivery.
# Generate with: openssl rand -hex 32
OTP_HMAC_SECRET=your_random_32_byte_otp_hmac_secret


# Antivirus scanning (file uploads)
# Set to "true" to enable the AV scan hook in storage upload helpers.
# NOTE: When set to "true", a warning is emitted until a real AV endpoint is wired in.
# TODO[AV]: wire in a real ClamAV / cloud AV endpoint when enabling this.
AV_SCAN_ENABLED=false
VITE_AV_SCAN_ENABLED=false

# Push Notifications (server)
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@haqak.org

# AI (server-side only)
# OpenAI is optional until AI features are fully enabled.
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
# Gemini is used for image/vision safety moderation (optional).
GEMINI_API_KEY=your_gemini_api_key
# Comma-separated list of hostnames allowed for user-supplied image URLs (SSRF allowlist).
# Supports exact hostnames (images.example.com) and wildcard subdomains (*.example.com).
# An empty value causes ALL image-URL fetches to be rejected (fail-closed).
ALLOWED_IMAGE_HOSTS=

ALLOWED_ORIGINS=https://haqak.app,https://www.haqak.app

# Supabase Auth email + verification messages (Resend)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL="Haqak <no-reply@haqak.org>"

# Blockchain audit trail HMAC key.
# This is for reference and secret rotation documentation only.
# The actual key MUST be set in the database via:
#   ALTER DATABASE <your_db> SET app.audit_hmac_key = '<secret>';
# TODO[Vault]: migrate to Supabase Vault / AWS Secrets Manager — do NOT commit real keys here.
AUDIT_HMAC_KEY=your_random_32_byte_audit_hmac_key
