# Supabase Edge Functions — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values before local development with
# the Supabase CLI (supabase functions serve).
#
# In production, set these via the Supabase Dashboard → Project Settings →
# Edge Functions → Secrets, or via the CLI:
#   supabase secrets set KEY=value
#
# ⚠️  NEVER commit .env or any file containing real secrets to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://wfuofurgkswotwuzosdd.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6IndmdW9mdXJna3N3b3R3dXpvc2RkIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzYzNzA2NzAsImV4cCI6MjA5MTk0NjY3MH0.TqA5IBu9uE1q31xUubBrRU4Dv43CaGu1STqhu6sTk1w

# SERVICE_ROLE_KEY — bootstrap secret for admin-level Supabase operations.
#
# Security model:
#   • In Supabase Edge Functions, SUPABASE_SERVICE_ROLE_KEY is automatically
#     injected by the runtime from your project's managed secrets store.
#     You do NOT need to set it manually unless running locally.
#   • For zero-downtime rotation, store other secrets in Supabase Vault:
#       1.  supabase vault add --name OTP_HMAC_SECRET --value "$(openssl rand -hex 32)"
#       2.  supabase secrets set SUPABASE_VAULT_ENABLED=true
#       3.  See docs/SECURITY_SECRET_ROTATION.md for the complete guide.
#
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Secret Manager (Vault) ────────────────────────────────────────────────────
# Set to "true" to fetch secrets from Supabase Vault before falling back to
# environment variables.  See supabase/functions/_shared/secrets.ts.
# Production deployments should enable this for zero-downtime rotation.
SUPABASE_VAULT_ENABLED=false

# ── OTP / HMAC ────────────────────────────────────────────────────────────────
# HMAC secret for signing OTP tokens before DB storage (keeps raw OTPs out of DB).
# This signs tokens internally — it is NOT related to the OTP email/SMS code that
# users receive. Supabase Auth handles OTP delivery independently.
# Generate with: openssl rand -hex 32
# Minimum 32 characters; must have high entropy (no placeholders or repeated chars).
OTP_HMAC_SECRET=your_random_32_byte_otp_hmac_secret




# ── Cloudflare Turnstile ──────────────────────────────────────────────────────
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://haqak.app,https://www.haqak.app

# ── Runtime ───────────────────────────────────────────────────────────────────
# Set to "development" to skip Turnstile CAPTCHA checks during local dev.
ENVIRONMENT=development

# ── AI (used by ai-legal-bot, classify-issue, refine-mp-post, etc.) ──────────
# OpenAI is optional until AI features are fully enabled.
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
# Gemini is used for image/vision safety moderation (optional).
GEMINI_API_KEY=your_gemini_api_key
# Comma-separated hostnames allowed for user-supplied image URLs (SSRF allowlist).
ALLOWED_IMAGE_HOSTS=

# ── Email (Resend) ────────────────────────────────────────────────────────────
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL="Haqak <no-reply@haqak.org>"

# ── Push Notifications (VAPID) ────────────────────────────────────────────────
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@haqak.org
